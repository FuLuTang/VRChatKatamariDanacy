  "registration_model": {
    "mode": "one_cell_at_a_time",
    "why": "motor 的静态盒上限 8、斜面上限 4；一个 22 格的场同时注册必然超容量并 latch overflow。所以每格自带一组 BoxCollider，切格时 motor.ClearObstacles() → 目标格 LevelArenaHost.Reapply()",
    "switch_rule": "active = 离球心最近的格足迹（外扩 activate_margin_m = r + 2.0）；换格需连续 0.25 s 稳定；球在无格区时保持上一格 1.0 s 后清到 base",
    "per_cell_arena": "every placement.json is a COMPLETE arena: ground + 4 boundary planes + that cell's boxes. motor.ClearObstacles() zeroes the global plane table, so the host that registers last owns every plane; a cell cannot borrow the field's walls from another host. The 4 wall objects are therefore duplicated per cell in the scene (they are markers, not colliders).",
    "base_registration": {
      "ground_plane": true,
      "planes": 4,
      "boxes": 0,
      "ramps": 0
    },
    "activate_margin_m": 2.0,
    "switch_debounce_s": 0.25,
    "cost_note": "每次切格一次 ClearObstacles + Reapply（分配一对 Vector3[]，见 TERRAIN_SUPPORT §3.5 的 GC 风险）"
  },
