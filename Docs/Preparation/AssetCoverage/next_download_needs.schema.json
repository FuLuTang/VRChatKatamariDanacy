{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vrc-katamari:next-download-need-row",
  "title": "P10 next asset need CSV row",
  "description": "A requirement record only. It does not identify a selected source or authorize searching/downloading.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "concept",
    "need_type",
    "minimum_need",
    "activation_gate",
    "new_package_download_authorized"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^PIC-[0-9]{2}$"},
    "concept": {"type": "string", "minLength": 1},
    "need_type": {"type": "string", "enum": ["NEW_ASSET_NEED", "VARIETY_DECISION", "SHAPE_VARIANT", "COMPOSITION_DECISION"]},
    "minimum_need": {"type": "string", "minLength": 1},
    "activation_gate": {"type": "string", "minLength": 1},
    "new_package_download_authorized": {"type": "string", "const": "NO"}
  }
}
