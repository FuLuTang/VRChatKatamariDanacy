  "driver": {
    "component": "PhysicsTestFieldDriver",
    "namespace": "VRCKatamari.Labs.PhysicsTestField",
    "path": "Assets/VRC_Katamari/Labs/PhysicsTestField/PhysicsTestFieldDriver.cs",
    "status": "WRITTEN_NOT_COMPILED",
    "runs_per_cell": 4,
    "log_prefix": "[ptf]",
    "result_tokens": [
      "EXPECTED",
      "UNEXPECTED_PASS",
      "UNEXPECTED_FAIL",
      "BLOCKED_UNTIL"
    ],
    "states": [
      "Idle",
      "Switch",
      "Size",
      "Settle",
      "Drive",
      "Report"
    ],
    "settle_seconds": 0.5,
    "kind_whitelist": [
      "lab-feeder"
    ],
    "kind_whitelist_note": "the driver re-sends this after every Reapply because the arena's own whitelist is the cell's prop kinds only; a feeder candidate must pass the same absorb gate as a prop. Extend it with the prop kinds when C18/C19 land",
    "blocked_notes": [
      "readout=trace checks are read from the console by a human, so the driver reports them as BLOCKED_UNTIL_manual and counts them as skipped, never as failures",
      "readout=counter checks need the P4 step-cost counters and report BLOCKED_UNTIL_P4",
      "gate=P2 checks are measured when a PickupFieldHost is wired with prop obstacles enabled (its SetSupportProps is the only path for prop tops; a disabled host clears both sets); gate=P3 still reports BLOCKED_UNTIL_P3 in this revision"
    ]
  },
  "ball_size": {
    "component": "LabBallSizeSetter",
    "path": "Assets/VRC_Katamari/Labs/PhysicsTestField/LabBallSizeSetter.cs",
    "status": "WRITTEN_NOT_COMPILED",
    "presets_m": [
      0.3,
      0.6,
      1.1,
      2.2
    ],
    "mode": "closed_loop_volume_feed",
    "tolerance_m": 0.002,
    "max_absorbs_per_request": 6,
    "reset_primitive": "motor.TryResetForNewRound(newRoundId, startCenter, heading, out reason)",
    "feed_primitive": "motor.SubmitCandidate(true, feederKind, feederBounds, ballCenter, units, feederId, gen)",
    "why_no_runtime_change": "the diameter is a pure function of the confirmed volume, and SubmitCandidate already exists as the host-side seam, so the setter feeds integer volume units and reads the diameter back. Integer because the absorb gate refuses a fractional value (TryAbsorbValueToLedgerGain)",
    "side_effects": "absorb count, ledger volume and the absorb volume limit all grow; every check that reads them uses a baseline delta (PHYSICS_TEST_FIELD 8.3)"
  },
  "criteria_importer": {
    "component": "PhysicsTestFieldCriteriaImporter",
    "path": "Assets/VRC_Katamari/Editor/PhysicsTestField/PhysicsTestFieldCriteriaImporter.cs",
    "menu": "VRC Katamari/Level/Import Physics Test Field Criteria",
    "status": "WRITTEN_NOT_COMPILED",
    "reads": [
      "Docs/Design/BallMotor/physics_test_field.json",
      "each wired cell's placement.json (start pose, activation rect, approach distance)"
    ],
    "writes": [
      "PhysicsTestCell: cellId, arena, startCenter, startHeadingDegrees, footprint, nominalM, approachM, check arrays, drive timeline",
      "PhysicsTestFieldDriver: cells[], presetDiametersM[], kindWhitelist",
      "LabBallSizeSetter: presetDiametersM[], presetLabels[] (same diameters[], same file)"
    ],
    "rule": "the JSON is the only authoring copy; nothing here is typed twice"
  },
